        "googleMaps": {
          "apiKey": "AIzaSyA1c1Gw2fRPp_bHw2_y_477IpVPzrCOqvg"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AquaPin to use your location to show ponds on the map."
        }
      ],
